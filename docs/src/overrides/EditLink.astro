---
import path from 'node:path';
import { postsDir } from '../lib/admin-utils';

const { entry } = Astro.locals.starlightRoute;
const relativePath = entry?.filePath ? path.relative(postsDir, entry.filePath) : '';
// Only offer inline editing for real content files inside the docs folder.
const canEdit =
	Boolean(relativePath) && !relativePath.startsWith('..') && /\.(md|mdx)$/.test(relativePath);
const label = Astro.locals.t('page.editLink');
---

{
	canEdit && (
		<button type="button" class="edit-page-btn print:hidden" data-path={relativePath} data-title={entry.data.title}>
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="1.2em" height="1.2em" fill="currentColor" aria-hidden="true">
				<path d="M20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34a.9959.9959 0 0 0-1.41 0l-1.84 1.83 3.75 3.75M3 17.25V21h3.75L17.81 9.93l-3.75-3.75z" />
			</svg>
			<span>{label}</span>
		</button>
	)
}

<style is:global>
	.edit-page-btn {
		display: inline-flex;
		gap: 0.5rem;
		align-items: center;
		background: none;
		border: none;
		padding: 0;
		margin: 0;
		cursor: pointer;
		font: inherit;
		color: var(--sl-color-gray-3);
	}
	.edit-page-btn:hover {
		color: var(--sl-color-white);
	}

	.sl-edit-overlay {
		position: fixed;
		inset: 0;
		background: rgba(0, 0, 0, 0.6);
		display: flex;
		align-items: center;
		justify-content: center;
		z-index: 1000;
		backdrop-filter: blur(4px);
	}
	.sl-edit-modal {
		background: var(--sl-color-bg);
		box-shadow: 0 0 0 1px var(--sl-color-hairline);
		border-radius: var(--sl-border-radius-lg);
		padding: 1.5rem;
		width: 90%;
		max-width: 48rem;
		max-height: 85vh;
		overflow-y: auto;
	}
	.sl-edit-modal h3 {
		font-size: 1.125rem;
		font-weight: 600;
		margin: 0 0 1.25rem;
		color: var(--sl-color-text);
	}
	.sl-edit-group {
		margin-bottom: 1rem;
	}
	.sl-edit-group label {
		display: block;
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--sl-color-gray-3);
		margin-bottom: 0.375rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}
	.sl-edit-group input,
	.sl-edit-group textarea {
		width: 100%;
		padding: 0.5rem 0.75rem;
		box-shadow: 0 0 0 1px var(--sl-color-hairline);
		border: 1px solid transparent;
		border-radius: var(--sl-border-radius-sm);
		background: var(--sl-color-black);
		color: var(--sl-color-text);
		font-family: inherit;
		font-size: 0.875rem;
		box-sizing: border-box;
		transition: border-color 0.2s;
	}
	.sl-edit-group input:focus,
	.sl-edit-group textarea:focus {
		outline: none;
		border-color: var(--sl-color-accent);
	}
	.sl-edit-group textarea {
		min-height: 16rem;
		resize: vertical;
		font-family: var(--sl-font-mono, ui-monospace, monospace);
	}
	.sl-edit-actions {
		display: flex;
		gap: 0.5rem;
		justify-content: flex-end;
		margin-top: 1.5rem;
	}
	.sl-edit-cancel {
		padding: 0.4375rem 1rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: var(--sl-border-radius-sm);
		background: transparent;
		color: var(--sl-color-gray-2);
		font-size: 0.8125rem;
		font-family: inherit;
		cursor: pointer;
	}
	.sl-edit-save {
		padding: 0.4375rem 1rem;
		border-radius: var(--sl-border-radius-sm);
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
		font-size: 0.8125rem;
		font-weight: 500;
		font-family: inherit;
		cursor: pointer;
		transition: background 0.2s;
	}
	.sl-edit-save:hover {
		background: var(--sl-color-accent-high);
	}
	.sl-edit-save:disabled {
		opacity: 0.6;
		cursor: default;
	}
	.sl-edit-status {
		font-size: 0.8125rem;
		color: var(--sl-color-gray-3);
		min-height: 1.2em;
	}
</style>

<script>
	(function () {
		if ((window as any).__slEditLinkInit) return;
		(window as any).__slEditLinkInit = true;

		const EDIT_API = '/api/page';
		const RELOAD_API = '/api/reload';
		let editingPath = '';

		function escapeHtml(s: unknown): string {
			return String(s ?? '')
				.replace(/&/g, '&amp;')
				.replace(/</g, '&lt;')
				.replace(/>/g, '&gt;')
				.replace(/"/g, '&quot;')
				.replace(/'/g, '&#39;');
		}

		function openEditor(relPath: string, fallbackTitle: string) {
			if (document.getElementById('sl-edit-modal')) return;
			editingPath = relPath;
			const overlay = document.createElement('div');
			overlay.className = 'sl-edit-overlay';
			overlay.id = 'sl-edit-modal';
			overlay.innerHTML =
				'<div class="sl-edit-modal">' +
				'<h3>Chỉnh sửa trang</h3>' +
				'<div class="sl-edit-group"><label>Tiêu đề</label>' +
				'<input type="text" id="sl-edit-title" value="' + escapeHtml(fallbackTitle) + '" /></div>' +
				'<div class="sl-edit-group"><label>Mô tả</label>' +
				'<input type="text" id="sl-edit-desc" /></div>' +
				'<div class="sl-edit-group"><label>Nội dung (Markdown)</label>' +
				'<textarea id="sl-edit-body"></textarea></div>' +
				'<div class="sl-edit-status"></div>' +
				'<div class="sl-edit-actions">' +
				'<button type="button" class="sl-edit-cancel">Hủy</button>' +
				'<button type="button" class="sl-edit-save">Lưu &amp; Tải lại</button>' +
				'</div></div>';
			overlay.addEventListener('click', (e) => {
				if (e.target === overlay) closeModal();
			});
			document.body.appendChild(overlay);

			const titleEl = overlay.querySelector('#sl-edit-title') as HTMLInputElement;
			const descEl = overlay.querySelector('#sl-edit-desc') as HTMLInputElement;
			const bodyEl = overlay.querySelector('#sl-edit-body') as HTMLTextAreaElement;
			const statusEl = overlay.querySelector('.sl-edit-status') as HTMLElement;
			overlay.querySelector('.sl-edit-cancel')!.addEventListener('click', closeModal);
			overlay.querySelector('.sl-edit-save')!.addEventListener('click', () => save(statusEl));

			fetch(EDIT_API + '?path=' + encodeURIComponent(relPath))
				.then((r) => r.json())
				.then((data) => {
					if (data.error) {
						statusEl.textContent = data.error;
						return;
					}
					if (!titleEl.value) titleEl.value = data.title || '';
					descEl.value = data.description || '';
					bodyEl.value = data.body || '';
				})
				.catch(() => {
					statusEl.textContent = 'Không thể tải nội dung. Đảm bảo dev server đang chạy.';
				});
			titleEl.focus();
		}

		function closeModal() {
			const modal = document.getElementById('sl-edit-modal');
			if (modal) modal.remove();
		}

		// After /api/reload triggers a full dev-server restart, wait until the
		// server responds again before reloading so we don't show an error page.
		async function waitUntilReady(statusEl: HTMLElement) {
			const url = window.location.pathname;
			const deadline = Date.now() + 30000;
			let dots = 0;
			while (Date.now() < deadline) {
				try {
					const res = await fetch(url, { method: 'GET' });
					if (res.ok) return;
				} catch {
					/* server still restarting */
				}
				dots = (dots + 1) % 4;
				statusEl.textContent = 'Đang khởi động lại server' + '.'.repeat(dots);
				await new Promise((r) => setTimeout(r, 700));
			}
		}

		async function save(statusEl: HTMLElement) {
			const modal = document.getElementById('sl-edit-modal');
			if (!modal) return;
			const title = (modal.querySelector('#sl-edit-title') as HTMLInputElement).value;
			const description = (modal.querySelector('#sl-edit-desc') as HTMLInputElement).value;
			const content = (modal.querySelector('#sl-edit-body') as HTMLTextAreaElement).value;
			const saveBtn = modal.querySelector('.sl-edit-save') as HTMLButtonElement;
			saveBtn.disabled = true;
			statusEl.textContent = 'Đang lưu...';
			try {
				const res = await fetch(EDIT_API, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ path: editingPath, title, description, content }),
				});
				const data = await res.json();
			if (data.success) {
				statusEl.textContent = 'Đã lưu. Đang khởi động lại server...';
				try {
					await fetch(RELOAD_API, { method: 'POST' });
				} catch {
					/* server restarting — ignore */
				}
				await waitUntilReady(statusEl);
				location.reload();
			} else {
					statusEl.textContent = data.error || 'Có lỗi xảy ra';
					saveBtn.disabled = false;
				}
			} catch {
				statusEl.textContent = 'Không thể lưu. Đảm bảo dev server đang chạy.';
				saveBtn.disabled = false;
			}
		}

		document.addEventListener('click', (e) => {
			const target = e.target as HTMLElement;
			const btn = target.closest('.edit-page-btn') as HTMLElement | null;
			if (!btn) return;
			e.preventDefault();
			const relPath = btn.getAttribute('data-path') || '';
			const fallbackTitle = btn.getAttribute('data-title') || '';
			if (relPath) openEditor(relPath, fallbackTitle);
		});
	})();
</script>
